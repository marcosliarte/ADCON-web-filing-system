# =============================================================================
# CONFIGURAÇÃO DO AMBIENTE - ARQUIVO DE EXEMPLO
# =============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha com valores reais
# NUNCA commit o arquivo .env para o Git!
#
# Para alternar entre LOCAL e PRODUÇÃO, descomente a linha correspondente:

# PRODUÇÃO (MongoDB Atlas - dados reais):
# MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/?appName=adcon

# LOCAL (MongoDB instalado no PC - apenas testes):
MONGODB_URI=mongodb://127.0.0.1:27017/system_adcon

# =============================================================================

# URIs de backup (não alterar)
MONGODB_URI_PROD=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/?appName=adcon
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/system_adcon

# JWT - IMPORTANTE: Gerar chave aleatória forte de 64+ caracteres
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_AQUI
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Porta do servidor
PORT=3000

# Caminho do mongodump/mongorestore (Windows)
MONGODUMP_PATH=C:\Program Files\MongoDB\Tools\100\bin\mongodump.exe
MONGORESTORE_PATH=C:\Program Files\MongoDB\Tools\100\bin\mongorestore.exe

# Limite de tamanho de upload (em MB)
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
